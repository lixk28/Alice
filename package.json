{
  "name": "hugo-alice",
  "version": "1.0.0",
  "private": true,
  "description": "Node dependencies and build tools for the Alice Hugo theme: KaTeX/MathJax assets plus the SVG icon sprite pipeline.",
  "scripts": {
    "build:icon": "node scripts/build-sprite.js",
    "build": "npm run build:icon && hugo",
    "serve": "npm run build:icon -- --watch & hugo server --bind 0.0.0.0 --port 1313 --disableFastRender",
    "build:docs": "npm run build:icon && hugo --source=docs",
    "serve:docs": "npm run build:icon -- --watch & hugo server --source=docs --bind 0.0.0.0 --port 1314 --disableFastRender"
  },
  "dependencies": {
    "katex": "0.19.1",
    "katex-hugo": "npm:katex@0.18.4",
    "mathjax": "3.2.2",
    "pseudocode": "2.4.1"
  },
  "optionalDependencies": {
    "svg-sprite": "^2.0.4",
    "svgo": "^3.3.2"
  }
}
